{
  "name": "tibodog",
  "version": "0.1.5",
  "description": "A notch widget (Claude Code/Codex usage, Now Playing) with a dog that barks when Tibo (@thsottiaux) resets the Codex limits on X",
  "type": "module",
  "bin": {
    "tibodog": "bin/tibodog.js"
  },
  "files": [
    "bin",
    "src",
    "sounds",
    "app/Package.swift",
    "app/LICENSE",
    "app/Sources",
    "app/Tests",
    "app/Resources",
    "app/Scripts",
    "app/Vendor",
    "!app/Vendor/mediaremote-adapter/build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/tibodog.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.11"
  },
  "keywords": [
    "codex",
    "claude-code",
    "usage",
    "notch",
    "macos",
    "rate-limit",
    "reset",
    "dog",
    "x",
    "twitter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewkim-11/tibodog.git"
  },
  "homepage": "https://github.com/matthewkim-11/tibodog",
  "license": "MIT"
}
